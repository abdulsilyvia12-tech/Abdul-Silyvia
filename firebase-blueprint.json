{
  "entities": {
    "MatchQueueEntry": {
      "title": "MatchQueueEntry",
      "description": "Represents an anonymous user waiting in the matchmaking queue for random Blink chat",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "anonymousId": { "type": "string" },
        "anonymousName": { "type": "string" },
        "anonymousAvatarColor": { "type": "string" },
        "status": { "type": "string", "enum": ["waiting", "matched", "cancelled"] },
        "matchedChatId": { "type": "string" },
        "peerAnonymousName": { "type": "string" },
        "peerAvatarColor": { "type": "string" },
        "joinedAt": { "type": "number" }
      },
      "required": ["id", "anonymousId", "status", "joinedAt"]
    },
    "ActiveRandomChat": {
      "title": "ActiveRandomChat",
      "description": "Active real-time anonymous random chat pairing two users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participantA": { "type": "string" },
        "participantB": { "type": "string" },
        "participantAName": { "type": "string" },
        "participantBName": { "type": "string" },
        "participantAAvatar": { "type": "string" },
        "participantBAvatar": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "skipped", "ended", "reported"] },
        "createdAt": { "type": "number" },
        "expiresAt": { "type": "number" },
        "lastMessage": { "type": "string" }
      },
      "required": ["id", "participantA", "participantB", "status", "createdAt", "expiresAt"]
    },
    "RandomChatMessage": {
      "title": "RandomChatMessage",
      "description": "A real-time message exchanged within an active anonymous random chat",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chatId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderAnonymousName": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "chatId", "senderId", "text", "createdAt"]
    }
  },
  "firestore": {
    "/match_queue/{queueId}": {
      "schema": { "$ref": "#/entities/MatchQueueEntry" },
      "description": "Queue entries for users seeking random anonymous chat pairing"
    },
    "/active_chats/{chatId}": {
      "schema": { "$ref": "#/entities/ActiveRandomChat" },
      "description": "Active random 2-minute chat session between paired users"
    },
    "/active_chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/RandomChatMessage" },
      "description": "Real-time messages sent within an active random anonymous chat"
    }
  }
}
